% ============================================================
% §2  AMBIENTES NUMERADOS — estilo plain
% ============================================================
% O contador 'teorema' é a raiz; todos os demais compartilham
% via sibling=teorema (incrementam o mesmo contador).

\newkeytheorem { theorem } [
  style        = plain              ,
  name         = Teorema                 ,
  numberwithin = section                 ,
  refname    = {teorema,teoremas}      ,
  Refname    = {Teorema,Teoremas}      ,
]

\newkeytheorem { lemma } [
  style        = plain              ,
  sibling      = theorem                 ,
  name         = Lema                    ,
  refname    = {lema,lemas}            ,
  Refname    = {Lema,Lemas}            ,
]

\newkeytheorem { corollary } [
  style        = plain              ,
  sibling      = theorem                 ,
  name         = Corolário               ,
  refname    = {corolário,corolários}  ,
  Refname    = {Corolário,Corolários}  ,
]

\newkeytheorem { proposition } [
  style        = plain              ,
  sibling      = theorem                 ,
  name         = Proposição              ,
  refname    = {proposição,proposições},
  Refname    = {Proposição,Proposições},
]

\newkeytheorem { claim } [
  style        = plain              ,
  sibling      = theorem                 ,
  name         = Afirmação               ,
  refname    = {afirmação,afirmações}  ,
  Refname    = {Afirmação,Afirmações}  ,
]

\newkeytheorem { conjecture } [
  style        = plain              ,
  sibling      = theorem                 ,
  name         = Conjectura              ,
  refname    = {conjectura,conjecturas},
  Refname    = {Conjectura,Conjecturas},
]

% ============================================================
% §3  AMBIENTES NUMERADOS — estilo definition
% ============================================================

\newkeytheorem { definition } [
  style        = definition         ,
  sibling      = theorem                 ,
  name         = Definição               ,
  refname    = {definição,definições}  ,
  Refname    = {Definição,Definições}  ,
]

\newkeytheorem { example } [
  style        = definition         ,
  sibling      = theorem                 ,
  name         = Exemplo                 ,
  refname    = {exemplo,exemplos}      ,
  Refname    = {Exemplo,Exemplos}      ,
]

\newkeytheorem { exercise } [
  style        = definition         ,
  sibling      = theorem                 ,
  name         = Exercício               ,
  refname    = {exercício,exercícios}  ,
  Refname    = {Exercício,Exercícios}  ,
]

\newkeytheorem { notation } [
  style        = definition         ,
  sibling      = theorem                 ,
  name         = Notação                 ,
  refname    = {notação,notações}      ,
  Refname    = {Notação,Notações}      ,
]

% ============================================================
% §4  AMBIENTES NÃO NUMERADOS
% ============================================================

\newkeytheorem { remark } [
  style    = remark ,
  numbered = no          ,
  name     = Observação  ,
]

\newkeytheorem { note } [
  style    = remark ,
  numbered = no          ,
  name     = Nota        ,
]

