%% ============================================================
%% Algumas dicas:
%%
%%   Rótulo e nome (sintaxe de chave-valor):
%%     \begin{theorem}[label=teo:baire, name={Baire}]
%%
%%   Restatement — reimprimir o enunciado com o mesmo número:
%%     \begin{theorem}[store=teo-baire, name={Baire}]
%%       Enunciado...
%%     \end{theorem}
%%     ...
%%     \restatetheorem{teo-baire}    % mesmo número, em qualquer ponto
%%     \restatetheorem*{teo-baire}   % só o corpo, sem cabeçalho
%%
%%   Número manual — para teoremas importados de outro documento:
%%     \begin{theorem}[manual-num=2.3, name={Baire}]
%%
%%   Lista de teoremas filtrada:
%%     \listofkeytheorems[title={Teoremas Principais}, only={theorem}]
%%
%% AMBIENTES DEFINIDOS:
%%   Numerados (contador compartilhado por seção):
%%     teorema, lema, corolario, proposicao, afirmacao,
%%     conjectura, definicao, exemplo, exercicio, notacao
%%   Não numerados:
%%     observacao, nota, prova (= proof em português)

%% USO EM ARTIGOS / OUTROS DOCUMENTOS:
%%   \usepackage{keytheorems}
%%   \usepackage{dmat-teoremas}
%%   — mesmos ambientes, sem dependência da classe ppgmat-ime-dissertacao.
%% ============================================================

\NeedsTeXFormat{LaTeX2e}[2022-11-01]
\RequirePackage{keytheorems}
